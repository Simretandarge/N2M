# Copy this file to .env and fill in your values.
# .env is ignored by git so your credentials stay local.

# --- Production (cPanel): hosts & CSRF ---
# Include both apex and www so https://www.yourdomain.com does not 400.
ALLOWED_HOSTS=localhost,127.0.0.1,next251.com,www.next251.com
# HTTPS origins for forms (comma-separated, no spaces).
CSRF_TRUSTED_ORIGINS=https://next251.com,https://www.next251.com
# Links inside emails from cron (e.g. send_scheduled_newsletters). Use your live https URL.
#SITE_PUBLIC_BASE_URL=https://www.next251.com
# Optional: newsletter digest footer social links (defaults are set in settings.py)
#SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/next251-media-n2m/
#SOCIAL_INSTAGRAM_URL=https://www.instagram.com/next251media/
#SOCIAL_FACEBOOK_URL=https://web.facebook.com/people/Next251-Media/61588122357942/

# --- Real inbox email ---
# If USE_REAL_EMAIL is not 1, Django uses the console backend: mail only appears in the
# server terminal, not in real inboxes (unless you set NEWSLETTER_EMAIL_* for SMTP below).
USE_REAL_EMAIL=1

# no-reply@: password reset, registration, and other system emails.
DEFAULT_FROM_EMAIL=no-reply@next251.com
# Newsletter: "from" and optional separate SMTP (e.g. newsletter@next251.com).
NEWSLETTER_FROM_EMAIL=newsletter@next251.com
# 0 to skip the automatic “welcome” email when someone newly subscribes to the newsletter
#NEWSLETTER_SEND_WELCOME_EMAIL=1
NEWSLETTER_EMAIL_HOST_USER=newsletter@next251.com
NEWSLETTER_EMAIL_HOST_PASSWORD=your-newsletter-password
EMAIL_HOST_USER=no-reply@next251.com
EMAIL_HOST_PASSWORD=your-email-account-password

# cPanel / next251.com: SMTP server is usually mail.yourdomain.com
# (Replace next251.com with your domain if different.)
EMAIL_HOST=mail.next251.com
EMAIL_PORT=465
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true

# --- Public like/save/view display boost (optional; admin always shows real DB counts) ---
# Likes default 15–45, saves 3–6, views = real_views + bump, floored at public_likes + gap.
#DISPLAY_COUNT_BOOST_ENABLED=1
#DISPLAY_LIKE_BOOST_MIN=15
#DISPLAY_LIKE_BOOST_MAX=45
#DISPLAY_SAVE_BOOST_MIN=3
#DISPLAY_SAVE_BOOST_MAX=6
#DISPLAY_VIEW_BOOST_MIN=22
#DISPLAY_VIEW_BOOST_MAX=72
#DISPLAY_VIEW_OVER_LIKE_MIN=12
#DISPLAY_VIEW_OVER_LIKE_MAX=52
# Minutes after publish before boosted counts kick in (each item gets a stable delay in this range).
# Set both to 0 for immediate boost; set both to 40 for exactly 40 minutes; 60/60 for 1 hour.
#DISPLAY_COUNT_BOOST_DELAY_MIN_MINUTES=30
#DISPLAY_COUNT_BOOST_DELAY_MAX_MINUTES=60
#DISPLAY_COUNT_SALT=

# --- Database ---
# Local dev default is SQLite. Set USE_POSTGRES=1 for cPanel/PostgreSQL.
USE_POSTGRES=0
DB_NAME=your_postgres_db_name
DB_USER=your_postgres_db_user
DB_PASSWORD=your_postgres_db_password
# For same cPanel server, localhost is usually correct.
DB_HOST=localhost
DB_PORT=5432
# Optional: require SSL with values like "require"
DB_SSLMODE=
